[Unit]
# Wraps the existing docker-compose.yaml stack (warden + warden-ui + the
# VPS-local postgres/traefik override) so systemd — not just Docker's own
# `restart: unless-stopped` — supervises it. Two things this buys over the
# container-only setup:
#   1. Boot-time start: containers with `restart: unless-stopped` only come
#      back if the Docker daemon itself was already running when they
#      stopped; they don't get (re)created from scratch after a host
#      reboot unless something starts them. `WantedBy=multi-user.target`
#      below does that.
#   2. `journalctl -u warden` instead of `docker logs`/`docker compose
#      logs`: `ExecStart` runs in the foreground (no `-d`), so its stdout/
#      stderr — which is every container's log output, prefixed by
#      service name — lands directly in the journal via systemd's default
#      `StandardOutput=journal`.
# This does NOT replace compose.yaml's own `restart: unless-stopped` on
# each service — that still recovers a single crashed *container* fast,
# without waiting on this unit at all. This unit is the outer layer: if
# the `docker compose up` process itself dies (lost its connection to a
# restarted Docker daemon, was OOM-killed, etc.), `Restart=always` below
# brings the whole stack back.
Description=Warden bot (docker compose: warden, warden-ui, postgres, traefik)
Documentation=https://github.com/mother-of-all-self-hosting
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/home/armin/warden
# --no-color: compose colorizes each service's log-line prefix when it
# thinks it's attached to a terminal; journald isn't one, but this forces
# it off defensively so journal entries never carry stray ANSI escapes.
# --remove-orphans: drops containers for services removed from
# compose.yaml over time instead of leaving them running unmanaged.
# Explicit service names, not a bare `up`: keeps this unit pinned to the
# services it actually supervises, so an override file gaining a service
# doesn't silently enlarge what systemd restarts. `traefik`/`warden-ui` are
# defined in compose.override.yaml (VPS-only, not shipped in this repo —
# see ARCHITECTURE.md §2 in the warden-ui repo for the reverse-proxy plan).
# Sidecars (searxng, llama-server, whisper-server, prosody) are NOT named
# here: they live in examples/*/compose.yaml, which this `docker compose`
# invocation doesn't merge, so naming one would fail the whole unit with
# "no such service". To supervise one, add its fragment with a `-f` here
# and add the service name to both lines below.
ExecStart=/usr/bin/docker compose up --no-color --remove-orphans warden warden-ui postgres traefik
ExecStop=/usr/bin/docker compose stop warden warden-ui postgres traefik
Restart=always
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
